{
  "name": "nature-project",
  "version": "1.0.0",
  "description": "Landing page for natours",
  "license": "ISC",
  "author": "Mohammad Bashar",
  "scripts": {
    "watch:sass": "sass sass/main.scss css/style.css --style=compressed --watch",
    "devserver": "live-server",
    "start": "npm-run-all --parallel devserver watch:sass",
    "compile:sass": "sass --no-source-map sass/main.scss css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.comp.css -o css/style.prefix.css",
    "compress:css": "sass --no-source-map css/style.prefix.css css/style.css --style=compressed",
    "build:css": "npm-run-all compile:sass prefix:css compress:css"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "live-server": "^1.2.0",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.1",
    "sass": "^1.97.1"
  }
}
